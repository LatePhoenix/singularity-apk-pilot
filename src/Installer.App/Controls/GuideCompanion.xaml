<UserControl x:Class="Installer.App.Controls.GuideCompanion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Installer.App.Controls"
             Focusable="False">
    <Border Style="{StaticResource Card}" Padding="12">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
                <controls:GuideAvatar DockPanel.Dock="Left"
                                      Mood="{Binding Guide.Mood}"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Top"
                                      AutomationProperties.Name="Pilot helper"/>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Guide.Progress}"
                                   Style="{StaticResource Eyebrow}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="PILOT" Style="{StaticResource Eyebrow}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Guide.Greeting}"
                               Style="{StaticResource H2}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Pop out"
                        Style="{StaticResource CompactPill}"
                        Command="{Binding PopOutGuideCommand}"
                        Margin="0,0,6,0"
                        Visibility="{Binding IsGuideDocked, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Pop out helper"
                        AutomationProperties.AutomationId="PopOutGuide"/>
                <Button Content="Dock"
                        Style="{StaticResource CompactPill}"
                        Command="{Binding DockGuideCommand}"
                        Margin="0,0,6,0"
                        Visibility="{Binding IsGuideDocked, Converter={StaticResource InverseBoolToVisibility}}"
                        AutomationProperties.Name="Dock helper"
                        AutomationProperties.AutomationId="DockGuide"/>
                <Button Content="Hide helper"
                        Style="{StaticResource CompactPill}"
                        Command="{Binding HideGuideCommand}"
                        AutomationProperties.Name="Hide helper"
                        AutomationProperties.AutomationId="HideGuide"/>
            </WrapPanel>

            <Expander x:Name="HelpExpander"
                      DockPanel.Dock="Bottom"
                      Header="Why am I seeing this?"
                      IsExpanded="{Binding IsGuideHelpExpanded, Mode=TwoWay}"
                      Margin="0,4,0,0"
                      AutomationProperties.Name="Why am I seeing this?">
                <TextBlock Text="{Binding CurrentPage.Help}" Style="{StaticResource Body}" Margin="0,6,0,0"/>
            </Expander>
            <Expander DockPanel.Dock="Bottom"
                      Header="Advanced details"
                      Margin="0,2,0,0"
                      AutomationProperties.Name="Advanced details">
                <TextBlock Text="{Binding CurrentPage.AdvancedDetails}" Style="{StaticResource Mono}" Margin="0,6,0,0"/>
            </Expander>

            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <StackPanel>
                    <Border Style="{StaticResource IllustrationWell}"
                            HorizontalAlignment="Stretch"
                            Visibility="{Binding CurrentPage.ShowIllustration, Converter={StaticResource BoolToVisibility}}">
                        <controls:DeviceIllustration Kind="{Binding CurrentPage.Illustration}"
                                                     Description="{Binding CurrentPage.IllustrationDescription}"
                                                     HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DO THIS NOW" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Guide.Now}" Style="{StaticResource GuideNow}"/>
                    <StackPanel Visibility="{Binding Guide.HasThen, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="THEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Guide.Then}" Style="{StaticResource GuideThen}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Guide.Checks}"
                                  Margin="0,0,0,8"
                                  Visibility="{Binding Guide.HasChecks, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Helper checklist">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Ellipse DockPanel.Dock="Left"
                                             Width="6" Height="6" Margin="0,5,8,0"
                                             Fill="{DynamicResource BrandCyanBrush}"
                                             VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource AccentCard}" Padding="8,6">
                        <TextBlock Text="{Binding Guide.ButtonHint}"
                                   Style="{StaticResource Label}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
