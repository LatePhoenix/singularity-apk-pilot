<UserControl x:Class="Installer.App.Controls.GuideAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AvatarStroke" Color="#2FA8C8"/>
        <SolidColorBrush x:Key="AvatarAccent" Color="#E020C8"/>
        <Style x:Key="Mark" TargetType="Shape">
            <Setter Property="Stroke" Value="{DynamicResource AvatarStroke}"/>
            <Setter Property="StrokeThickness" Value="2.25"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Line X1="24" Y1="20" X2="16" Y2="8" Style="{StaticResource Mark}"/>
            <Ellipse Canvas.Left="12" Canvas.Top="4" Width="8" Height="8" Style="{StaticResource Mark}"/>
            <Line X1="40" Y1="20" X2="48" Y2="8" Style="{StaticResource Mark}"/>
            <Ellipse Canvas.Left="44" Canvas.Top="4" Width="8" Height="8" Style="{StaticResource Mark}"/>
            <Path Data="M 12,38 A 20,20 0 0 1 52,38 L 52,54 Q 52,58 48,58 L 16,58 Q 12,58 12,54 Z"
                  Style="{StaticResource Mark}"/>
            <Line X1="12" Y1="50" X2="52" Y2="50" Style="{StaticResource Mark}"/>
            <Line X1="12" Y1="36" X2="20" Y2="36" Style="{StaticResource Mark}"/>
            <Line X1="44" Y1="36" X2="52" Y2="36" Style="{StaticResource Mark}"/>
            <Rectangle Canvas.Left="20" Canvas.Top="31" Width="24" Height="10" RadiusX="5" RadiusY="5"
                       Style="{StaticResource Mark}"/>
            <Rectangle Canvas.Left="24" Canvas.Top="34" Width="16" Height="4" RadiusX="2" RadiusY="2"
                       Stroke="{StaticResource AvatarAccent}"
                       StrokeThickness="1.75"
                       Fill="Transparent"
                       StrokeStartLineCap="Round"
                       StrokeEndLineCap="Round"
                       StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
