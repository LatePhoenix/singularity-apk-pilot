<UserControl x:Class="Installer.App.Controls.DeviceIllustration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="Stroke" TargetType="Shape">
            <Setter Property="Stroke" Value="{DynamicResource BrandCyanBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="Hairline" TargetType="Shape" BasedOn="{StaticResource Stroke}">
            <Setter Property="Stroke" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform" MaxHeight="148" MaxWidth="280" HorizontalAlignment="Left">
        <Grid Width="280" Height="148">
            <Canvas x:Name="CableCanvas" Visibility="Collapsed">
                <Line X1="24" Y1="74" X2="256" Y2="74" Style="{StaticResource Hairline}"/>
                <Ellipse Canvas.Left="132" Canvas.Top="68" Width="16" Height="16" Style="{StaticResource Hairline}"/>
                <Line X1="140" Y1="60" X2="140" Y2="88" Style="{StaticResource Hairline}"/>
                <Rectangle Canvas.Left="16" Canvas.Top="44" Width="56" Height="60" RadiusX="6" RadiusY="6" Style="{StaticResource Stroke}"/>
                <Rectangle Canvas.Left="28" Canvas.Top="56" Width="32" Height="20" RadiusX="2" RadiusY="2" Style="{StaticResource Hairline}"/>
                <Rectangle Canvas.Left="72" Canvas.Top="68" Width="18" Height="12" RadiusX="2" RadiusY="2" Style="{StaticResource Stroke}"/>
                <Path Data="M 90,74 C 120,74 120,108 160,108 C 190,108 200,74 208,74" Style="{StaticResource Stroke}"/>
                <Rectangle Canvas.Left="208" Canvas.Top="68" Width="18" Height="12" RadiusX="2" RadiusY="2" Style="{StaticResource Stroke}"/>
                <Rectangle Canvas.Left="226" Canvas.Top="50" Width="40" Height="48" RadiusX="10" RadiusY="10" Style="{StaticResource Stroke}"/>
                <Line X1="238" Y1="62" X2="254" Y2="62" Style="{StaticResource Hairline}"/>
            </Canvas>

            <Canvas x:Name="HeadsetCanvas" Visibility="Collapsed">
                <Path Data="M 48,86 C 48,58 86,42 140,42 C 194,42 232,58 232,86 L 220,108 C 200,124 168,132 140,132 C 112,132 80,124 60,108 Z" Style="{StaticResource Stroke}"/>
                <Path Data="M 78,86 C 78,74 104,66 140,66 C 176,66 202,74 202,86" Style="{StaticResource Hairline}"/>
                <Ellipse Canvas.Left="96" Canvas.Top="78" Width="28" Height="22" Style="{StaticResource Hairline}"/>
                <Ellipse Canvas.Left="156" Canvas.Top="78" Width="28" Height="22" Style="{StaticResource Hairline}"/>
                <Line X1="70" Y1="92" X2="48" Y2="118" Style="{StaticResource Stroke}"/>
                <Line X1="210" Y1="92" X2="232" Y2="118" Style="{StaticResource Stroke}"/>
                <Rectangle Canvas.Left="128" Canvas.Top="128" Width="24" Height="8" RadiusX="2" RadiusY="2" Style="{StaticResource Stroke}"/>
            </Canvas>

            <Canvas x:Name="PhoneCanvas" Visibility="Collapsed">
                <Rectangle Canvas.Left="108" Canvas.Top="18" Width="64" Height="112" RadiusX="12" RadiusY="12" Style="{StaticResource Stroke}"/>
                <Line X1="128" Y1="30" X2="152" Y2="30" Style="{StaticResource Hairline}"/>
                <Rectangle Canvas.Left="120" Canvas.Top="40" Width="40" Height="68" RadiusX="2" RadiusY="2" Style="{StaticResource Hairline}"/>
                <Ellipse Canvas.Left="134" Canvas.Top="112" Width="12" Height="12" Style="{StaticResource Hairline}"/>
            </Canvas>

            <Canvas x:Name="HeadsetPromptCanvas" Visibility="Collapsed">
                <Path Data="M 36,86 C 36,58 74,42 128,42 C 182,42 220,58 220,86 L 208,108 C 188,124 156,132 128,132 C 100,132 68,124 48,108 Z" Style="{StaticResource Stroke}"/>
                <Ellipse Canvas.Left="84" Canvas.Top="78" Width="26" Height="20" Style="{StaticResource Hairline}"/>
                <Ellipse Canvas.Left="144" Canvas.Top="78" Width="26" Height="20" Style="{StaticResource Hairline}"/>
                <Rectangle Canvas.Left="198" Canvas.Top="28" Width="64" Height="44" RadiusX="9" RadiusY="9" Fill="{DynamicResource SurfaceRaisedBrush}" Stroke="{DynamicResource BrandCyanBrush}" StrokeThickness="1.5"/>
                <TextBlock Canvas.Left="210" Canvas.Top="40" Text="Allow" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}"/>
            </Canvas>

            <Canvas x:Name="PhonePromptCanvas" Visibility="Collapsed">
                <Rectangle Canvas.Left="88" Canvas.Top="18" Width="64" Height="112" RadiusX="12" RadiusY="12" Style="{StaticResource Stroke}"/>
                <Rectangle Canvas.Left="98" Canvas.Top="40" Width="44" Height="56" RadiusX="2" RadiusY="2" Style="{StaticResource Hairline}"/>
                <Rectangle Canvas.Left="168" Canvas.Top="48" Width="88" Height="52" RadiusX="9" RadiusY="9" Fill="{DynamicResource SurfaceRaisedBrush}" Stroke="{DynamicResource BrandCyanBrush}" StrokeThickness="1.5"/>
                <TextBlock Canvas.Left="180" Canvas.Top="66" Text="Allow" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}"/>
            </Canvas>

            <Canvas x:Name="DeveloperModeCanvas" Visibility="Collapsed">
                <Rectangle Canvas.Left="28" Canvas.Top="28" Width="52" Height="92" RadiusX="10" RadiusY="10" Style="{StaticResource Stroke}"/>
                <Line X1="40" Y1="40" X2="68" Y2="40" Style="{StaticResource Hairline}"/>
                <Line X1="40" Y1="56" X2="68" Y2="56" Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="2"/>
                <Line X1="40" Y1="72" X2="68" Y2="72" Style="{StaticResource Hairline}"/>
                <Path Data="M 108,86 C 108,62 140,48 184,48 C 228,48 256,62 256,86 L 246,106 C 230,118 206,126 184,126 C 162,126 138,118 122,106 Z" Style="{StaticResource Stroke}"/>
                <Line X1="80" Y1="74" X2="108" Y2="74" Style="{StaticResource Stroke}"/>
            </Canvas>

            <Canvas x:Name="PackageCanvas" Visibility="Collapsed">
                <Path Data="M 48,70 L 88,50 L 128,70 L 88,90 Z" Style="{StaticResource Stroke}"/>
                <Path Data="M 48,70 L 48,102 L 88,122 L 88,90 Z" Style="{StaticResource Stroke}"/>
                <Path Data="M 128,70 L 128,102 L 88,122 L 88,90 Z" Style="{StaticResource Stroke}"/>
                <Line X1="88" Y1="50" X2="88" Y2="90" Style="{StaticResource Hairline}"/>
                <Line X1="140" Y1="86" X2="176" Y2="86" Style="{StaticResource Stroke}"/>
                <Polygon Points="168,78 184,86 168,94" Fill="{DynamicResource BrandCyanBrush}" Stroke="Transparent"/>
                <Path Data="M 196,86 C 196,64 220,50 248,64 C 248,100 228,118 208,118 C 192,118 186,102 196,86 Z" Style="{StaticResource Stroke}"/>
            </Canvas>

            <Canvas x:Name="InstallingCanvas" Visibility="Collapsed">
                <Path Data="M 40,70 L 76,52 L 112,70 L 76,88 Z" Style="{StaticResource Stroke}"/>
                <Line X1="124" Y1="70" X2="168" Y2="70" Style="{StaticResource Stroke}"/>
                <Polygon Points="160,62 176,70 160,78" Fill="{DynamicResource BrandCyanBrush}" Stroke="Transparent"/>
                <Rectangle Canvas.Left="188" Canvas.Top="28" Width="56" Height="96" RadiusX="10" RadiusY="10" Style="{StaticResource Stroke}"/>
                <Line X1="40" Y1="120" X2="244" Y2="120" Style="{StaticResource Hairline}"/>
                <Line X1="40" Y1="120" X2="140" Y2="120" Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="2"/>
            </Canvas>

            <Canvas x:Name="ProblemCanvas" Visibility="Collapsed">
                <Path Data="M 140,28 L 212,120 L 68,120 Z" Stroke="{DynamicResource WarningTextBrush}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                <Line X1="140" Y1="56" X2="140" Y2="88" Stroke="{DynamicResource WarningTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                <Ellipse Canvas.Left="134" Canvas.Top="96" Width="12" Height="12" Fill="{DynamicResource WarningTextBrush}" Stroke="Transparent"/>
            </Canvas>

            <Canvas x:Name="CompleteCanvas" Visibility="Collapsed">
                <Ellipse Canvas.Left="96" Canvas.Top="28" Width="88" Height="88" Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Path Data="M 120,74 L 136,90 L 168,54" Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="2.5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>

            <Canvas x:Name="ConnectOptionsCanvas" Visibility="Collapsed">
                <Rectangle Canvas.Left="16" Canvas.Top="44" Width="56" Height="60" RadiusX="6" RadiusY="6" Style="{StaticResource Stroke}"/>
                <Rectangle Canvas.Left="28" Canvas.Top="56" Width="32" Height="20" RadiusX="2" RadiusY="2" Style="{StaticResource Hairline}"/>
                <Rectangle Canvas.Left="72" Canvas.Top="68" Width="18" Height="12" RadiusX="2" RadiusY="2" Style="{StaticResource Stroke}"/>
                <Path Data="M 90,74 C 118,74 118,108 156,108 C 176,108 186,86 192,80" Style="{StaticResource Stroke}"/>
                <Path Data="M 108,52 A 22,22 0 0 1 146,52" Style="{StaticResource Hairline}"/>
                <Path Data="M 98,42 A 34,34 0 0 1 156,42" Stroke="{DynamicResource BrandCyanBrush}" StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 90,32 A 46,46 0 0 1 164,32" Style="{StaticResource Hairline}"/>
                <Path Data="M 196,86 C 196,62 220,48 248,48 C 268,48 268,72 268,86 L 260,106 C 248,118 228,124 212,124 C 198,124 186,116 180,106 Z" Style="{StaticResource Stroke}"/>
                <Ellipse Canvas.Left="216" Canvas.Top="78" Width="20" Height="16" Style="{StaticResource Hairline}"/>
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
