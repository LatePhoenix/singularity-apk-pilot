<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Singularity Design System v1.2 — copied from Studio DarkTheme.xaml / design tokens. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1722"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#161F2D"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1D2838"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B0F17"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#2C3A4D"/>
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#1A2333"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EAF1F8"/>
    <SolidColorBrush x:Key="BodyTextBrush" Color="#9FB0C3"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9FB0C3"/>
    <SolidColorBrush x:Key="BrandCyanBrush" Color="#2FA8C8"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#1F5FAF"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#3DDC84"/>
    <SolidColorBrush x:Key="MeterLowBrush" Color="#3FA56A"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#06131C"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#C48B2D"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="#B94E63"/>
    <SolidColorBrush x:Key="OnDangerTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1D2838"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2C3A4D"/>

    <DrawingBrush x:Key="AppBackgroundGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,24,24"
                  ViewportUnits="Absolute"
                  Opacity="0.04">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Pen>
                    <Pen Brush="White" Thickness="1"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="0,24"/>
                        <LineGeometry StartPoint="0,0" EndPoint="24,0"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
