<UserControl x:Class="Installer.App.Views.Pages.InstalledAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:Installer.App.ViewModels.Wizard">
    <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource Label}"
                   Foreground="{DynamicResource BrandCyanBrush}"
                   Margin="0,0,0,12"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource WarningTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <Border Style="{StaticResource AccentCard}"
                Margin="0,0,0,16"
                Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="REMOVE APP" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding ConfirmTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ConfirmBody}"
                           Style="{StaticResource Label}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Remove"
                            Style="{StaticResource SecondaryPill}"
                            Command="{Binding ConfirmRemoveCommand}"
                            IsEnabled="{Binding CanRemove}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Confirm remove app"
                            AutomationProperties.AutomationId="ConfirmRemoveApp"/>
                    <Button Content="Cancel"
                            Style="{StaticResource GhostPill}"
                            Command="{Binding CancelConfirmCommand}"
                            IsEnabled="{Binding CanRemove}"
                            AutomationProperties.Name="Cancel remove"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Search" Style="{StaticResource Label}" Margin="0,0,0,4"/>
        <TextBox Style="{StaticResource WizardInput}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToEnabled}}"
                 AutomationProperties.Name="Search installed apps"/>
        <DockPanel Margin="0,12,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Style="{StaticResource GhostPill}"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToEnabled}}"
                    Height="32"
                    MinWidth="72"
                    AutomationProperties.Name="Refresh installed apps"
                    AutomationProperties.AutomationId="RefreshInstalledApps"/>
            <TextBlock Text="{Binding EmptyHint}"
                       Style="{StaticResource Label}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding EmptyHint, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding VisibleApps}"
                      Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="Installed apps">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type wizard:InstalledAppRow}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource GhostPill}"
                                    Content="Remove"
                                    Height="32"
                                    MinWidth="72"
                                    Margin="12,0,0,0"
                                    Command="{Binding DataContext.AskRemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="Remove installed app"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="  · recently used"
                                               Style="{StaticResource Label}"
                                               Foreground="{DynamicResource BrandCyanBrush}"
                                               Visibility="{Binding IsRecent, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}"
                                           Style="{StaticResource Mono}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Removing…"
                                           Style="{StaticResource Label}"
                                           Foreground="{DynamicResource BrandCyanBrush}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
