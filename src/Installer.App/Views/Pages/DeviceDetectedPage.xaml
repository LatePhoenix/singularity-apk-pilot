<UserControl x:Class="Installer.App.Views.Pages.DeviceDetectedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Installer.Core.Models;assembly=Installer.Core">
    <StackPanel Margin="0,16,0,0">
        <Border Style="{StaticResource RaisedWell}"
                Margin="0,0,0,16"
                Padding="16"
                Visibility="{Binding ShowPicker, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource H2}"/>
        </Border>
        <ListBox ItemsSource="{Binding Candidates}"
                 SelectedItem="{Binding SelectedDevice}"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 FocusVisualStyle="{x:Null}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding ShowPicker, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="Connected devices">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DevicePickerItem}"/>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:DeviceInfo}">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Label}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
