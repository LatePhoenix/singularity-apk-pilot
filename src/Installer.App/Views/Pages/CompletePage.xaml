<UserControl x:Class="Installer.App.Views.Pages.CompletePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Notes}"
                      Margin="0,0,0,8"
                      AutomationProperties.Name="How to open the app">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel>
            <Button Content="{Binding OpenLabel}"
                    Style="{StaticResource SecondaryPill}"
                    Command="{Binding OpenOnDeviceCommand}"
                    IsEnabled="{Binding CanOpen}"
                    Margin="0,0,8,0"
                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Open on device"
                    AutomationProperties.AutomationId="OpenOnDevice"/>
            <Button Content="Installed apps"
                    Style="{StaticResource SecondaryPill}"
                    Command="{Binding OpenInstalledAppsCommand}"
                    AutomationProperties.Name="Installed apps"
                    AutomationProperties.AutomationId="OpenInstalledAppsFromComplete"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
