<UserControl x:Class="Installer.App.Views.Pages.ReadyToInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:Installer.App.ViewModels.Wizard"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave">
    <StackPanel>
        <TextBlock Text="Connected over Wi-Fi. You can leave the cable unplugged."
                   Style="{StaticResource Label}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   Visibility="{Binding ShowWifiConnected, Converter={StaticResource BoolToVisibility}}"/>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="Switch to Wi-Fi"
                    Style="{StaticResource CompactPill}"
                    Command="{Binding UseWifiCommand}"
                    IsEnabled="{Binding CanUseWifi}"
                    Margin="0,0,8,6"
                    Visibility="{Binding ShowUseWifi, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Switch to Wi-Fi"
                    AutomationProperties.AutomationId="UseWifi"/>
            <Button Content="Installed apps"
                    Style="{StaticResource CompactPill}"
                    Command="{Binding OpenInstalledAppsCommand}"
                    Margin="0,0,8,6"
                    AutomationProperties.Name="Installed apps"
                    AutomationProperties.AutomationId="OpenInstalledApps"/>
            <Button Content="Use last files"
                    Style="{StaticResource CompactPill}"
                    Command="{Binding UseLastFilesCommand}"
                    Margin="0,0,0,6"
                    Visibility="{Binding ShowUseLastFiles, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Use last files"
                    AutomationProperties.AutomationId="UseLastFiles"/>
        </WrapPanel>
        <TextBlock Text="{Binding SplitWarning}"
                   Style="{StaticResource WarningBanner}"
                   Visibility="{Binding SplitWarning, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        <Border x:Name="DropZoneBorder" Style="{StaticResource DropZone}">
            <StackPanel>
                <TextBlock Text="APP FILES" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/>
                <TextBlock Text="Drop APK, APKS, or XAPK files here, or add them below."
                           Style="{StaticResource Label}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ApkFiles}"
                              AutomationProperties.Name="Selected APK files">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type wizard:ApkFileItem}">
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource CompactPill}"
                                            Content="Remove"
                                            Command="{Binding DataContext.RemoveApkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="Remove APK"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   Style="{StaticResource Label}"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EmptyHint}"
                           Style="{StaticResource Label}"
                           Margin="0,0,0,8"
                           Visibility="{Binding EmptyHint, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                <Button Content="Add app files"
                        Style="{StaticResource SecondaryPill}"
                        Command="{Binding AddApksCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Add app files"
                        AutomationProperties.AutomationId="AddApkFiles"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
