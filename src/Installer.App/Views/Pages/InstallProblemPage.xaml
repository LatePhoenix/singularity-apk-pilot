<UserControl x:Class="Installer.App.Views.Pages.InstallProblemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Actions}"
                      Margin="0,0,0,4"
                      Visibility="{Binding HasMoreActions, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="Suggested next steps">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowCard}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryPill}"
                                    Content="{Binding Title}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Title}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
