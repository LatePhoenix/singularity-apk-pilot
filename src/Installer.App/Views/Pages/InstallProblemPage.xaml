<UserControl x:Class="Installer.App.Views.Pages.InstallProblemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,0,0,4"
                      AutomationProperties.Name="Suggested next steps">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel>
            <Button Content="Replace this app"
                    Style="{StaticResource SecondaryPill}"
                    Command="{Binding ReplaceThisAppCommand}"
                    Margin="0,0,8,4"
                    Visibility="{Binding ShowReplace, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Replace this app"
                    AutomationProperties.AutomationId="ReplaceThisApp"/>
            <Button Content="Remove this app and install"
                    Style="{StaticResource SecondaryPill}"
                    Command="{Binding RemoveThisAppCommand}"
                    Margin="0,0,0,4"
                    Visibility="{Binding ShowRemove, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Remove this app and install"
                    AutomationProperties.AutomationId="RemoveThisApp"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
