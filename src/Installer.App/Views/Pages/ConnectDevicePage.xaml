<UserControl x:Class="Installer.App.Views.Pages.ConnectDevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding HealthHint}"
                   Foreground="{DynamicResource WarningTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding HealthHint, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        <TextBlock Text="{Binding WifiStatus}"
                   Foreground="{DynamicResource WarningTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding WifiStatus, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        <TextBlock Text="{Binding RememberedLabel}"
                   Style="{StaticResource Label}"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasRememberedEndpoint, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Connect over Wi-Fi"
                Style="{StaticResource SecondaryPill}"
                Command="{Binding ConnectRememberedCommand}"
                IsEnabled="{Binding CanConnectRemembered}"
                HorizontalAlignment="Left"
                Margin="0,0,0,16"
                Visibility="{Binding HasRememberedEndpoint, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Connect over Wi-Fi"
                AutomationProperties.AutomationId="ConnectOverWifi"/>
        <Border Style="{StaticResource Card}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Use a Wi-Fi address" FontWeight="SemiBold"/>
                <TextBlock Text="The device must be on the same network as this computer. Pairing code is optional."
                           Style="{StaticResource Label}"
                           Margin="0,4,0,12"/>
                <TextBlock Text="Address" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource WizardInput}"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Wi-Fi address"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pairing port" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource WizardInput}"
                                 Text="{Binding PairingPort, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Pairing port"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pairing code" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource WizardInput}"
                                 Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Pairing code"/>
                    </StackPanel>
                </Grid>
                <Button Content="Connect"
                        Style="{StaticResource SecondaryPill}"
                        Command="{Binding ConnectAdvancedCommand}"
                        IsEnabled="{Binding CanConnectAdvanced}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        AutomationProperties.Name="Connect with Wi-Fi address"
                        AutomationProperties.AutomationId="ConnectWifiAddress"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
