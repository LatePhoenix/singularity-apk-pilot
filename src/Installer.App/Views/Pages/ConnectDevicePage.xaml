<UserControl x:Class="Installer.App.Views.Pages.ConnectDevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:Installer.App.ViewModels.Wizard">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type wizard:GuideStep}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12"
                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Number}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandCyanBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding Text}"
                           TextWrapping="Wrap"
                           Style="{StaticResource Body}"
                           Margin="0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding HealthHint}"
                   Foreground="{DynamicResource WarningTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding HealthHint, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        <TextBlock Text="{Binding WifiStatus}"
                   Foreground="{DynamicResource WarningTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding WifiStatus, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        <TextBlock Text="{Binding ConnectingLabel}"
                   Style="{StaticResource Label}"
                   Foreground="{DynamicResource BrandCyanBrush}"
                   Margin="0,0,0,12"
                   Visibility="{Binding ConnectingLabel, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <Border Style="{StaticResource AccentCard}"
                Margin="0,0,0,12"
                Visibility="{Binding HasRememberedEndpoint, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="SAVED WI-FI" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Connect over Wi-Fi" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,4"/>
                <TextBlock Text="{Binding RememberedLabel}" Style="{StaticResource Mono}" Margin="0,0,0,8"/>
                <TextBlock Text="Same network as this computer. After a headset reboot, plug in once more."
                           Style="{StaticResource Label}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <Button Content="Connect over Wi-Fi"
                        Style="{StaticResource SecondaryPill}"
                        Command="{Binding ConnectRememberedCommand}"
                        IsEnabled="{Binding CanConnectRemembered}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Connect over Wi-Fi"
                        AutomationProperties.AutomationId="ConnectOverWifi"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="USB" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Plug a USB-C data cable into the headset or phone, then tap I connected it below."
                           Style="{StaticResource Body}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                Padding="16">
            <StackPanel>
                <TextBlock Text="WI-FI" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Connect over Wi-Fi" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,4"/>
                <TextBlock Text="Quest 2 and Quest 3: set up with a cable once, then unplug. Phones can use the same address form."
                           Style="{StaticResource Label}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Expander Header="How to set up Wi-Fi on Quest 2 or Quest 3"
                          IsExpanded="{Binding ShowWifiGuideExpanded, Mode=OneWay}"
                          Margin="0,0,0,8"
                          AutomationProperties.Name="How to set up Wi-Fi on Quest 2 or Quest 3">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Recommended: USB once, then switch"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding QuestWifiSteps}"
                                      AutomationProperties.Name="Quest Wi-Fi setup steps"/>
                        <TextBlock Text="This is the Meta-supported path. Keep the headset and this computer on the same Wi-Fi after you unplug."
                                   Style="{StaticResource Label}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Expander>

                <Expander Header="I already have a pairing code from the headset"
                          Margin="0,0,0,16"
                          AutomationProperties.Name="I already have a pairing code from the headset">
                    <StackPanel Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding PairingSteps}"
                                      AutomationProperties.Name="Headset pairing steps"/>
                    </StackPanel>
                </Expander>

                <TextBlock Text="Install address" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource WizardInput}"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Wi-Fi install address"
                         AutomationProperties.HelpText="IP address and port, for example 192.168.1.42:5555"/>
                <TextBlock Text="IP and port from the headset. If there is no port, 5555 is used."
                           Style="{StaticResource Label}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pairing port" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource WizardInput}"
                                 Text="{Binding PairingPort, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Pairing port"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Six-digit code" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource WizardInput}"
                                 Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Pairing code"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Leave pairing blank unless the headset is showing a new code. Do not use the pairing port as the install address."
                           Style="{StaticResource Label}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,12"/>
                <Button Content="Connect over Wi-Fi"
                        Style="{StaticResource SecondaryPill}"
                        Command="{Binding ConnectAdvancedCommand}"
                        IsEnabled="{Binding CanConnectAdvanced}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Connect with Wi-Fi address"
                        AutomationProperties.AutomationId="ConnectWifiAddress"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
