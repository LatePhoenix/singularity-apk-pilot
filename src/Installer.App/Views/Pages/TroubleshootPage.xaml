<UserControl x:Class="Installer.App.Views.Pages.TroubleshootPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding ActionStatus}"
                   Style="{StaticResource WarningBanner}"
                   Visibility="{Binding ActionStatus, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <Grid Visibility="{Binding ShowFamilyPicker, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource AccentCard}" Padding="10">
                <StackPanel>
                    <TextBlock Text="QUEST" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Quest 2, 3, 3S, or Pro" Style="{StaticResource H2}" Margin="0,4,0,8"/>
                    <Button Content="This is a Quest"
                            Style="{StaticResource SecondaryPill}"
                            Command="{Binding ChooseQuestCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="This is a Quest"
                            AutomationProperties.AutomationId="TroubleshootChooseQuest"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource RaisedWell}" Padding="12">
                <StackPanel>
                    <TextBlock Text="PHONE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Android phone" Style="{StaticResource H2}" Margin="0,4,0,8"/>
                    <Button Content="This is a phone"
                            Style="{StaticResource SecondaryPill}"
                            Command="{Binding ChoosePhoneCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="This is a phone"
                            AutomationProperties.AutomationId="TroubleshootChoosePhone"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Visibility="{Binding ShowFamilyPicker, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Style="{StaticResource AccentCard}"
                    Margin="0,0,0,12"
                    Padding="12"
                    Visibility="{Binding LooksLikeQuest, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Switch to Quest"
                            Style="{StaticResource SecondaryPill}"
                            Command="{Binding SwitchToQuestCommand}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Switch to Quest"/>
                    <StackPanel>
                        <TextBlock Text="This looks like a Quest" Style="{StaticResource H2}"/>
                        <TextBlock Text="Windows sees a headset. Switch if you picked phone by mistake."
                                   Style="{StaticResource Label}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Steps}"
                          Margin="0,0,0,8"
                          AutomationProperties.Name="Troubleshooting steps"/>

            <Button Content="I installed it"
                    Style="{StaticResource GhostPill}"
                    Command="{Binding ConfirmInstalledCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"
                    Visibility="{Binding ShowConfirmInstalled, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="I installed it"
                    AutomationProperties.AutomationId="TroubleshootConfirmInstalled"/>
        </StackPanel>
    </StackPanel>
</UserControl>
