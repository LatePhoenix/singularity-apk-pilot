<UserControl x:Class="Installer.App.Views.Pages.TroubleshootPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:Installer.App.ViewModels.Wizard">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type wizard:GuideStep}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12"
                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Number}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandCyanBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding Text}"
                           TextWrapping="Wrap"
                           Style="{StaticResource Body}"
                           Margin="0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding ActionStatus}"
                   Foreground="{DynamicResource WarningTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding ActionStatus, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <StackPanel Visibility="{Binding ShowFamilyPicker, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource AccentCard}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="QUEST" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Meta Quest 2 or Quest 3" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,4"/>
                    <TextBlock Text="A headset that uses the Meta Horizon app for developer mode."
                               Style="{StaticResource Label}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <Button Content="This is a Quest"
                            Style="{StaticResource SecondaryPill}"
                            Command="{Binding ChooseQuestCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="This is a Quest"
                            AutomationProperties.AutomationId="TroubleshootChooseQuest"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="PHONE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Android phone" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,4"/>
                    <TextBlock Text="A phone that uses USB debugging in developer options."
                               Style="{StaticResource Label}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <Button Content="This is a phone"
                            Style="{StaticResource SecondaryPill}"
                            Command="{Binding ChoosePhoneCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="This is a phone"
                            AutomationProperties.AutomationId="TroubleshootChoosePhone"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding ShowFamilyPicker, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Style="{StaticResource AccentCard}"
                    Margin="0,0,0,12"
                    Padding="16"
                    Visibility="{Binding LooksLikeQuest, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="This looks like a Quest" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Windows sees a headset. Switch if you picked phone by mistake."
                               Style="{StaticResource Label}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <Button Content="Switch to Quest"
                            Style="{StaticResource SecondaryPill}"
                            Command="{Binding SwitchToQuestCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Switch to Quest"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Steps}"
                          Margin="0,0,0,12"
                          AutomationProperties.Name="Troubleshooting steps"/>

            <Button Content="{Binding InPageActionLabel}"
                    Style="{StaticResource SecondaryPill}"
                    Command="{Binding RunActionCommand}"
                    IsEnabled="{Binding ActionBusy, Converter={StaticResource InverseBoolToEnabled}}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowInPageAction, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{Binding InPageActionLabel}"
                    AutomationProperties.AutomationId="TroubleshootAction"/>

            <Button Content="Previous step"
                    Style="{StaticResource GhostPill}"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Left"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Previous step"
                    AutomationProperties.AutomationId="TroubleshootBack"/>
        </StackPanel>
    </StackPanel>
</UserControl>
