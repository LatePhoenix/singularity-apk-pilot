<Window x:Class="Installer.App.Views.SendReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send a report"
        Width="480"
        SizeToContent="Height"
        MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="Send a report">
    <Grid Background="{StaticResource AppBackgroundGridBrush}">
        <DockPanel Margin="24">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryPill}"
                        Content="Send report"
                        Command="{Binding SendCommand}"
                        IsDefault="True"
                        TabIndex="1"
                        AutomationProperties.Name="Send report"
                        AutomationProperties.AutomationId="SendReportConfirm"
                        Visibility="{Binding ShowResult, Converter={StaticResource InverseBoolToVisibility}}"/>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryPill}"
                        Content="Done"
                        Command="{Binding CloseCommand}"
                        IsDefault="True"
                        IsCancel="True"
                        TabIndex="1"
                        AutomationProperties.Name="Done"
                        AutomationProperties.AutomationId="SendReportDone"
                        Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}"/>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GhostPill}"
                        Content="Cancel"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        TabIndex="2"
                        AutomationProperties.Name="Cancel"
                        Visibility="{Binding ShowResult, Converter={StaticResource InverseBoolToVisibility}}"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Orientation="Vertical">
                    <TextBlock Style="{StaticResource Label}"
                               Text="Preparing the report…"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <ProgressBar Width="120"
                                 Height="4"
                                 Margin="0,8,0,0"
                                 HorizontalAlignment="Left"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Preparing report"/>
                </StackPanel>
            </DockPanel>
            <StackPanel>
                <TextBlock Text="REPORT" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Send a report"
                           Style="{StaticResource H1}"
                           Margin="0,8,0,12"
                           Visibility="{Binding ShowResult, Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBlock Text="{Binding ResultHeadline}"
                           Style="{StaticResource H1}"
                           Margin="0,8,0,12"
                           Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Visibility="{Binding ShowResult, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource Body}"
                               Text="Enter the email of the person who asked you to test. Your email app will open with the report attached. You still press Send there — this installer does not send mail by itself."/>
                    <TextBlock Text="Their email" Style="{StaticResource Label}" Margin="0,4,0,4"/>
                    <TextBox x:Name="EmailBox"
                             Style="{StaticResource WizardInput}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToEnabled}}"
                             AutomationProperties.Name="Email address"
                             AutomationProperties.HelpText="Email of the person who asked you to test"
                             AutomationProperties.AutomationId="ReportRecipientEmail"/>
                    <TextBlock Text="Use the address they already gave you."
                               Style="{StaticResource Label}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource ErrorBanner}"
                               Margin="0,12,0,0"
                               Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{Binding ResultBody}"
                           Style="{StaticResource Body}"
                           Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Error}"
                           Style="{StaticResource ErrorBanner}"
                           Margin="0,0,0,8"
                           Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}"/>
                <Border Style="{StaticResource RaisedWell}"
                        Margin="0,8,0,0"
                        Visibility="{Binding ShowAttachHint, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Report file" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AttachmentPath}"
                                   Style="{StaticResource Mono}"
                                   TextWrapping="Wrap"/>
                        <Button Content="Copy file location"
                                Style="{StaticResource GhostPill}"
                                Command="{Binding CopyPathCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                AutomationProperties.Name="Copy file location"/>
                        <TextBlock Text="{Binding CopyHint}"
                                   Style="{StaticResource Label}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding CopyHint, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
